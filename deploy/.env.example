# Copy to deploy/.env and fill in. Names only here: never commit values.
# Public domain Caddy serves and the NEP-413 login recipient (e.g. app.example.com).
APP_HOST=
# Long random string (e.g. `openssl rand -hex 32`). Signs login nonces.
SESSION_SECRET=
# Main NEAR mainnet RPC (web reads, worker sends). Empty: https://free.rpc.fastnear.com.
NEAR_RPC_URL=
# Comma-separated RPCs the worker rotates through for chain reads. Empty: built-in defaults.
NEAR_RPC_URLS=
# Pinned vault contract code hash. The browser bundle gets NEXT_PUBLIC_VAULT_CODE_HASH at build time
# (defaults to VAULT_CODE_HASH): rebuild web after changing it (`docker compose build web`).
VAULT_CODE_HASH=
NEXT_PUBLIC_VAULT_CODE_HASH=
# 1 (default): sign but never send. 0: real transactions with real funds.
DRY_RUN=1
# Notifications. NTFY_URL empty: https://ntfy.sh.
NTFY_URL=
HOST_NTFY_TOPIC=
TELEGRAM_BOT_TOKEN=
HOST_TELEGRAM_CHAT_ID=
# Worker internal API port (internal backend network only, never published). Default 8700.
WORKER_PORT=
# Host path for SQLite and bot keys, relative to deploy/. Default ../data (repo root data/).
DATA_DIR=
# Optional: host ports for Caddy (default 80/443). INSECURE_COOKIES=1 only for local http testing.
HTTP_PORT=
HTTPS_PORT=
INSECURE_COOKIES=
